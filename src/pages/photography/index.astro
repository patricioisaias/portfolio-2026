---
import { getCollection } from "astro:content";
import Layout from "../../layouts/Layout.astro";
import PhotoCard from "../../components/PhotoCard.astro";

const photos = (await getCollection("photography")).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
---

<Layout
  title="Fotografía | Patricio Céspedes"
  description="Fotografía callejera y registro documental de artes escénicas."
>
  <div class="space-y-10">
    <!-- Page Header -->
    <header class="space-y-3 max-w-2xl">
      <h1
        class="text-3xl sm:text-4xl font-bold tracking-tight text-neutral-950 dark:text-neutral-50"
      >
        Fotografía
      </h1>
      <p
        class="text-sm sm:text-base text-neutral-600 dark:text-neutral-400 leading-relaxed"
      >
        Fotografía callejera y registro documental de artes escénicas
      </p>
    </header>

    <!-- Photography Grid -->
    <section
      class="grid grid-cols-1 md:grid-cols-2 gap-6"
      aria-label="Listado de fotografía"
    >
      {photos.map((photo) => <PhotoCard photo={photo} />)}
    </section>
  </div>
</Layout>
