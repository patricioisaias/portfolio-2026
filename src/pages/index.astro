---
import { getCollection } from "astro:content";
import { Image } from "astro:assets";
import Layout from "../layouts/Layout.astro";
import ProjectCard from "../components/ProjectCard.astro";
import { siteConfig } from "../site.config";
import homeCover from "../assets/home-cover.jpg";

const allProjects = await getCollection("projects");
const featuredProjects = allProjects
  .filter((p) => p.data.featured)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 2);
---

<Layout title={siteConfig.title} description={siteConfig.description}>
  <div class="space-y-16 sm:space-y-20">
    <!-- Hero Section -->
    <section class="space-y-8">
      <!-- Main Headline -->
      <div class="space-y-4">
        <h1
          class="text-3xl sm:text-5xl font-bold tracking-tight text-neutral-950 dark:text-neutral-50 leading-[1.15]"
        >
          Patricio Céspedes
        </h1>
        <p
          class="text-base sm:text-lg text-neutral-600 dark:text-neutral-400 leading-relaxed"
        >
          Desarrollador de software y artista interdisciplinario. Mi trabajo
          explora la intersección entre arte y tecnología mediante proyectos que
          integran sistemas generativos, música y desarrollo de aplicaciones.
        </p>
      </div>

      <!-- Action Buttons -->
      <div class="flex flex-wrap items-center gap-3 pt-2">
        <a
          href="/projects"
          class="inline-flex items-center justify-center px-4 py-2 text-sm font-medium rounded-lg bg-neutral-900 text-white dark:bg-neutral-100 dark:text-neutral-900 hover:opacity-90 transition-opacity"
        >
          Explorar Proyectos
        </a>
        <a
          href="/about"
          class="inline-flex items-center justify-center px-4 py-2 text-sm font-medium rounded-lg border border-neutral-300 dark:border-neutral-700 text-neutral-700 dark:text-neutral-300 hover:bg-neutral-50 dark:hover:bg-neutral-900 transition-colors"
        >
          Sobre mí
        </a>
      </div>

      <!-- Hero Banner Image -->
      <div
        class="border border-neutral-200/60 dark:border-neutral-800/60 overflow-hidden bg-neutral-100 dark:bg-neutral-900"
      >
        <img
          src={homeCover.src}
          width={homeCover.width}
          height={homeCover.height}
          alt="Monochrome Sonatas - Serie fotográfica en blanco y negro"
          class="w-full h-auto pointer-events-none select-none"
          loading="eager"
          fetchpriority="high"
          data-no-zoom
        />
      </div>

      <!-- Core Pillars -->
      <div
        class="grid grid-cols-1 sm:grid-cols-3 gap-6 pt-8 border-t border-neutral-200/60 dark:border-neutral-800/60 text-xs sm:text-sm text-neutral-600 dark:text-neutral-400"
      >
        <div class="space-y-1.5">
          <h2
            class="font-semibold text-neutral-950 dark:text-neutral-100 text-sm"
          >
            Desarrollo de Software
          </h2>
          <p class="leading-relaxed">
            Backend, microservicios, diseño de APIs REST y arquitecturas cloud.
          </p>
        </div>
        <div class="space-y-1.5">
          <h2
            class="font-semibold text-neutral-950 dark:text-neutral-100 text-sm"
          >
            Arte y Tecnología
          </h2>
          <p class="leading-relaxed">
            Arte generativo, fotografía y música como medios de expresión
            artística.
          </p>
        </div>
        <div class="space-y-1.5">
          <h2
            class="font-semibold text-neutral-950 dark:text-neutral-100 text-sm"
          >
            Investigación
          </h2>
          <p class="leading-relaxed">
            Proyectos interdisciplinarios que exploran nuevas formas de
            interacción mediante tecnología y diseño.
          </p>
        </div>
      </div>
    </section>

    <!-- Featured Projects Section -->
    <section class="space-y-6">
      <div
        class="flex items-baseline justify-between border-b border-neutral-200/60 dark:border-neutral-800/60 pb-3"
      >
        <h2
          class="text-xl font-bold tracking-tight text-neutral-950 dark:text-neutral-50"
        >
          Proyectos Destacados
        </h2>
        <a
          href="/projects"
          class="text-xs font-medium text-neutral-500 hover:text-neutral-900 dark:text-neutral-400 dark:hover:text-neutral-100 transition-colors"
        >
          Ver todos ({allProjects.length}) →
        </a>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        {featuredProjects.map((project) => <ProjectCard project={project} />)}
      </div>
    </section>
  </div>
</Layout>
