---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import ProjectCard from '../components/ProjectCard.astro';
import NoteCard from '../components/NoteCard.astro';
import { siteConfig } from '../site.config';

const featuredProjects = (await getCollection('projects', ({ data }) => data.featured))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 2);

const recentNotes = (await getCollection('notes', ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 2);
---

<Layout title={siteConfig.title} description={siteConfig.description}>
  <div class="space-y-16 sm:space-y-20">
    
    <!-- Hero Section -->
    <section class="space-y-8 max-w-3xl">
      <!-- Profile Badge -->
      <div class="inline-flex items-center gap-2 px-3 py-1 text-xs font-mono bg-neutral-100 dark:bg-neutral-900 border border-neutral-200/80 dark:border-neutral-800 text-neutral-700 dark:text-neutral-300">
        Analista Programador <span class="text-neutral-400 dark:text-neutral-600">|</span> Licenciado en Artes
      </div>

      <!-- Main Headline -->
      <div class="space-y-4">
        <h1 class="text-3xl sm:text-5xl font-bold tracking-tight text-neutral-950 dark:text-neutral-50 leading-[1.15]">
          Arquitectura backend, sistemas distribuidos, expresión creativa.
        </h1>
        <p class="text-base sm:text-lg text-neutral-600 dark:text-neutral-400 leading-relaxed">
          Desarrollador de software con trayectoria en gestión interdisciplinaria, docencia musical, artes visuales. Enfocado en el diseño de microservicios robustos, infraestructura cloud, interfaces elegantes.
        </p>
      </div>

      <!-- Action Buttons -->
      <div class="flex flex-wrap items-center gap-3 pt-2">
        <a
          href="/projects"
          class="inline-flex items-center justify-center px-4 py-2 text-sm font-medium rounded-lg bg-neutral-900 text-white dark:bg-neutral-100 dark:text-neutral-900 hover:opacity-90 transition-opacity"
        >
          Explorar Proyectos
        </a>
        <a
          href="/about"
          class="inline-flex items-center justify-center px-4 py-2 text-sm font-medium rounded-lg border border-neutral-300 dark:border-neutral-700 text-neutral-700 dark:text-neutral-300 hover:bg-neutral-50 dark:hover:bg-neutral-900 transition-colors"
        >
          Sobre mi trayectoria
        </a>
      </div>

      <!-- Core Pillars -->
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 pt-8 border-t border-neutral-200/60 dark:border-neutral-800/60 text-xs text-neutral-500 dark:text-neutral-400">
        <div class="space-y-1">
          <span class="font-medium text-neutral-900 dark:text-neutral-200">Backend & Cloud</span>
          <p>Go, Node.js, Docker, Microservicios, PostgreSQL, AWS.</p>
        </div>
        <div class="space-y-1">
          <span class="font-medium text-neutral-900 dark:text-neutral-200">Gestión & Docencia</span>
          <p>Liderazgo de proyectos, Premio Azul universitario, educación musical.</p>
        </div>
        <div class="space-y-1">
          <span class="font-medium text-neutral-900 dark:text-neutral-200">Creación Digital</span>
          <p>Fotografía, arte generativo, síntesis sonora, diseño UI.</p>
        </div>
      </div>
    </section>

    <!-- Featured Projects Section -->
    <section class="space-y-6">
      <div class="flex items-baseline justify-between border-b border-neutral-200/60 dark:border-neutral-800/60 pb-3">
        <h2 class="text-xl font-bold tracking-tight text-neutral-950 dark:text-neutral-50">
          Proyectos Destacados
        </h2>
        <a href="/projects" class="text-xs font-medium text-neutral-500 hover:text-neutral-900 dark:text-neutral-400 dark:hover:text-neutral-100 transition-colors">
          Ver todos ({featuredProjects.length}) →
        </a>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        {featuredProjects.map((project) => (
          <ProjectCard project={project} />
        ))}
      </div>
    </section>

    <!-- Recent Notes Section -->
    <section class="space-y-6">
      <div class="flex items-baseline justify-between border-b border-neutral-200/60 dark:border-neutral-800/60 pb-3">
        <h2 class="text-xl font-bold tracking-tight text-neutral-950 dark:text-neutral-50">
          Últimas Notas
        </h2>
        <a href="/notes" class="text-xs font-medium text-neutral-500 hover:text-neutral-900 dark:text-neutral-400 dark:hover:text-neutral-100 transition-colors">
          Ver bitácora completa →
        </a>
      </div>

      <div class="divide-y divide-neutral-200/60 dark:divide-neutral-800/60">
        {recentNotes.map((note) => (
          <NoteCard note={note} />
        ))}
      </div>
    </section>

  </div>
</Layout>
