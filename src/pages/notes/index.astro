---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import NoteCard from '../../components/NoteCard.astro';

const notes = (await getCollection('notes', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
---

<Layout
  title="Notas & Bitácora | Patricio"
  description="Reflexiones sobre ingeniería de software, arquitectura backend, experimentación sonora, metodologías."
>
  <div class="max-w-3xl mx-auto space-y-10">
    
    <!-- Header -->
    <header class="space-y-3">
      <div class="inline-flex items-center gap-2 px-2.5 py-0.5 rounded-full text-xs font-mono bg-neutral-100 dark:bg-neutral-900 border border-neutral-200/80 dark:border-neutral-800 text-neutral-600 dark:text-neutral-400">
        <span>Diario Técnico & Ensayos</span>
      </div>
      <h1 class="text-3xl sm:text-4xl font-bold tracking-tight text-neutral-950 dark:text-neutral-50">
        Notas & Escritos
      </h1>
      <p class="text-sm sm:text-base text-neutral-600 dark:text-neutral-400 leading-relaxed">
        Apuntes sobre arquitectura distribuida, patrones de concurrencia, docencia, procesos creativos.
      </p>
    </header>

    <!-- Notes List -->
    <section class="divide-y divide-neutral-200/60 dark:divide-neutral-800/60" aria-label="Listado de notas">
      {notes.map((note) => (
        <NoteCard note={note} />
      ))}
    </section>

  </div>
</Layout>
