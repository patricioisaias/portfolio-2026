---
import ThemeToggle from './ThemeToggle.astro';
import { siteConfig } from '../site.config';

export interface Props {
  currentPath?: string;
}

const pathname = Astro.props.currentPath ?? Astro.url.pathname;
---

<header
  class="sticky top-0 z-50 w-full backdrop-blur-md bg-white/80 dark:bg-neutral-950/80 border-b border-neutral-200/60 dark:border-neutral-800/60 transition-colors duration-200"
>
  <div
    class="max-w-5xl mx-auto px-4 sm:px-6 h-14 flex items-center justify-between"
  >
    <!-- Brand / Logo -->
    <a
      href="/"
      class="group flex items-center gap-1.5 text-base sm:text-lg font-semibold tracking-tight text-neutral-950 dark:text-neutral-50 hover:opacity-80 transition-opacity"
      aria-label="Ir al inicio"
    >
      <span class="text-accent font-mono font-bold">●/</span>
      <span>{siteConfig.author}</span>
    </a>

    <!-- Desktop Navigation -->
    <nav
      class="hidden md:flex items-center gap-1 text-sm font-medium text-neutral-600 dark:text-neutral-400"
      aria-label="Navegación principal"
    >
      {
        siteConfig.navItems.map((item) => {
          const isActive =
            pathname === item.href ||
            (item.href !== "/" && pathname.startsWith(item.href));
          return (
            <a
              href={item.href}
              class={`px-3 py-1.5 text-sm transition-all ${
                isActive
                  ? "text-neutral-950 dark:text-white font-semibold underline decoration-2 underline-offset-[6px] decoration-accent"
                  : "hover:text-neutral-950 dark:hover:text-white hover:underline hover:decoration-2 hover:underline-offset-[6px] hover:decoration-accent"
              }`}
            >
              {item.name}
            </a>
          );
        })
      }

      <div
        class="h-4 w-px bg-neutral-200 dark:bg-neutral-800 mx-2"
        aria-hidden="true"
      >
      </div>

      <!-- Theme Toggle -->
      <ThemeToggle />
    </nav>

    <!-- Mobile Actions (Theme Toggle) -->
    <div class="flex md:hidden items-center gap-2">
      <ThemeToggle />
    </div>
  </div>

</header>
