---
import ThemeToggle from './ThemeToggle.astro';
import { siteConfig } from '../site.config';

export interface Props {
  currentPath?: string;
}

const pathname = Astro.props.currentPath ?? Astro.url.pathname;
---

<header class="sticky top-0 z-50 w-full backdrop-blur-md bg-white/80 dark:bg-neutral-950/80 border-b border-neutral-200/60 dark:border-neutral-800/60 transition-colors duration-200">
  <div class="max-w-5xl mx-auto px-4 sm:px-6 h-14 flex items-center justify-between">
    <!-- Brand / Logo -->
    <a
      href="/"
      class="text-sm sm:text-base font-semibold tracking-tight text-neutral-950 dark:text-neutral-50 hover:opacity-80 transition-opacity"
      aria-label="Ir al inicio"
    >
      {siteConfig.author}
    </a>

    <!-- Desktop Navigation -->
    <nav class="hidden md:flex items-center gap-1 text-sm font-medium text-neutral-600 dark:text-neutral-400" aria-label="Navegación principal">
      {siteConfig.navItems.map((item) => {
        const isActive = pathname === item.href || (item.href !== '/' && pathname.startsWith(item.href));
        return (
          <a
            href={item.href}
            class={`px-3 py-1.5 rounded-md text-sm transition-colors ${
              isActive
                ? 'text-neutral-950 dark:text-white font-semibold bg-neutral-200/60 dark:bg-neutral-800/60'
                : 'hover:text-accent dark:hover:text-accent hover:bg-accent/5 dark:hover:bg-accent/10'
            }`}
          >
            {item.name}
          </a>
        );
      })}

      <div class="h-4 w-px bg-neutral-200 dark:bg-neutral-800 mx-2" aria-hidden="true"></div>

      <!-- Theme Toggle -->
      <ThemeToggle />
    </nav>

    <!-- Mobile Menu Button & Toggle -->
    <div class="flex md:hidden items-center gap-2">
      <ThemeToggle />
      <button
        id="mobile-menu-btn"
        type="button"
        aria-label="Abrir menú de navegación"
        aria-expanded="false"
        class="p-2 rounded-lg text-neutral-600 dark:text-neutral-400 hover:text-accent dark:hover:text-accent hover:bg-accent/5 dark:hover:bg-accent/10 transition-colors focus:outline-none focus:ring-2 focus:ring-accent/50"
      >
        <svg id="menu-icon-open" class="w-5 h-5 block" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6.75h16.5M3.75 12h16.5m-16.5 5.25h16.5" />
        </svg>
        <svg id="menu-icon-close" class="w-5 h-5 hidden" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" d="M6 18 18 6M6 6l12 12" />
        </svg>
      </button>
    </div>
  </div>

  <!-- Mobile Drawer -->
  <div 
    id="mobile-menu" 
    class="absolute top-full left-0 w-full md:hidden border-b border-neutral-200/60 dark:border-neutral-800/60 bg-white/98 dark:bg-neutral-950/98 backdrop-blur-xl px-4 pt-4 pb-6 transition-all duration-300 ease-out opacity-0 invisible -translate-y-2 shadow-xl shadow-neutral-200/20 dark:shadow-black/40"
  >
    <nav class="flex flex-col space-y-2" aria-label="Navegación móvil">
      {siteConfig.navItems.map((item) => {
        const isActive = pathname === item.href || (item.href !== '/' && pathname.startsWith(item.href));
        return (
          <a
            href={item.href}
            class={`px-4 py-3 rounded-lg text-base font-medium transition-all duration-200 ${
              isActive
                ? 'text-neutral-950 dark:text-white font-semibold bg-neutral-100 dark:bg-neutral-800/80 shadow-sm'
                : 'text-neutral-600 dark:text-neutral-400 hover:text-neutral-950 dark:hover:text-white hover:bg-neutral-50 dark:hover:bg-neutral-900/50'
            }`}
          >
            {item.name}
          </a>
        );
      })}
    </nav>
  </div>
</header>

<script>
  const setupMobileMenu = () => {
    const btn = document.getElementById('mobile-menu-btn');
    const menu = document.getElementById('mobile-menu');
    const iconOpen = document.getElementById('menu-icon-open');
    const iconClose = document.getElementById('menu-icon-close');

    if (!btn || !menu || !iconOpen || !iconClose) return;

    // Reset state on load/swap to prevent visual bugs
    menu.classList.remove('opacity-100', 'visible', 'translate-y-0');
    menu.classList.add('opacity-0', 'invisible', '-translate-y-2');
    btn.setAttribute('aria-expanded', 'false');
    iconOpen.classList.remove('hidden');
    iconClose.classList.add('hidden');

    btn.addEventListener('click', () => {
      const isExpanded = btn.getAttribute('aria-expanded') === 'true';
      btn.setAttribute('aria-expanded', String(!isExpanded));
      
      if (isExpanded) {
        // Cierra el menú
        menu.classList.remove('opacity-100', 'visible', 'translate-y-0');
        menu.classList.add('opacity-0', 'invisible', '-translate-y-2');
      } else {
        // Abre el menú
        menu.classList.remove('opacity-0', 'invisible', '-translate-y-2');
        menu.classList.add('opacity-100', 'visible', 'translate-y-0');
      }

      iconOpen.classList.toggle('hidden');
      iconClose.classList.toggle('hidden');
    });
  };

  setupMobileMenu();
  document.addEventListener('astro:after-swap', setupMobileMenu);
</script>
