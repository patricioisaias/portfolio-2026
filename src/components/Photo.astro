---
import { Image } from 'astro:assets';

interface Props {
  src: any;
  alt: string;
  full?: boolean;
}

const { src, alt, full = false } = Astro.props;
---

<div class:list={[
  "overflow-hidden border border-neutral-200/60 dark:border-neutral-800/60",
  full && "sm:col-span-2"
]}>
  <Image src={src} alt={alt} class="w-full h-auto object-cover" />
</div>
