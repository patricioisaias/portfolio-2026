---
export interface Props {
  className?: string;
}

const { className = '' } = Astro.props;
---

<article
  class={`group relative flex flex-col justify-between overflow-hidden rounded-sm border border-neutral-200/70 dark:border-neutral-800/70 bg-neutral-50/40 dark:bg-neutral-900/30 hover:bg-neutral-100 dark:hover:bg-neutral-900/80 hover:border-neutral-300 dark:hover:border-neutral-700 transition-all duration-500 ease-out hover:shadow-[0_8px_30px_rgb(0,0,0,0.04)] dark:hover:shadow-[0_0_20px_rgba(255,255,255,0.03)] hover:-translate-y-1 active:scale-[0.98] ${className}`}
>
  <slot />
</article>
