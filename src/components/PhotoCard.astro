---
import type { CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';
import { formatDate } from '../utils/date';

export interface Props {
  photo: CollectionEntry<'photography'>;
}

const { photo } = Astro.props;
const { title, description, pubDate, category = 'Fotografía', links = {}, coverImage, coverAlt } = photo.data;
---

<article class="group relative flex flex-col justify-between p-6 border border-neutral-200/70 dark:border-neutral-800/70 bg-neutral-50/40 dark:bg-neutral-900/30 hover:bg-white dark:hover:bg-neutral-900/80 hover:border-neutral-300 dark:hover:border-neutral-700 transition-all duration-200 hover:shadow-xs">
  
  <div class="space-y-4">
    <!-- Optional Cover Image -->
    {coverImage && (
      <div class="overflow-hidden aspect-[4/3] bg-neutral-100 dark:bg-neutral-800 border border-neutral-200/40 dark:border-neutral-800/40">
        <Image
          src={coverImage}
          alt={coverAlt || title}
          class="w-full h-full object-cover group-hover:scale-102 transition-transform duration-300"
          loading="lazy"
        />
      </div>
    )}

    <!-- Category & Date -->
    <div class="flex items-center justify-between gap-2 text-xs">
      <span class="inline-flex items-center px-2.5 py-0.5 font-medium border border-neutral-200/80 dark:border-neutral-800 bg-neutral-200/50 dark:bg-neutral-800 text-neutral-700 dark:text-neutral-300">
        {category}
      </span>
      <time datetime={pubDate.toISOString()} class="text-neutral-400 dark:text-neutral-500 font-mono text-[11px]">
        {formatDate(pubDate)}
      </time>
    </div>

    <!-- Title & Description -->
    <div class="space-y-2">
      <h2 class="text-lg font-semibold tracking-tight text-neutral-950 dark:text-neutral-50 group-hover:text-neutral-600 dark:group-hover:text-neutral-300 transition-colors">
        <a href={`/photography/${photo.id}`} class="focus:outline-none">
          <span class="absolute inset-0 z-0" aria-hidden="true"></span>
          {title}
        </a>
      </h2>
      {description && (
        <p class="text-sm text-neutral-600 dark:text-neutral-400 line-clamp-3 leading-relaxed">
          {description}
        </p>
      )}
    </div>
  </div>

  <!-- External Links (if any) -->
  {(links.github || links.live) && (
    <div class="pt-4 mt-4 border-t border-neutral-200/50 dark:border-neutral-800/50 flex items-center justify-end gap-3 z-10 text-neutral-500 dark:text-neutral-400">
      {links.github && (
        <a
          href={links.github}
          target="_blank"
          rel="noopener noreferrer"
          class="hover:text-neutral-950 dark:hover:text-white transition-colors"
          aria-label={`Ver repositorio de ${title} en GitHub`}
        >
          <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
            <path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"/>
          </svg>
        </a>
      )}

      {links.live && (
        <a
          href={links.live}
          target="_blank"
          rel="noopener noreferrer"
          class="hover:text-neutral-950 dark:hover:text-white transition-colors"
          aria-label={`Ver demo en vivo de ${title}`}
        >
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 6H5.25A2.25 2.25 0 0 0 3 8.25v10.5A2.25 2.25 0 0 0 5.25 21h10.5A2.25 2.25 0 0 0 18 18.75V10.5m-10.5 6L21 3m0 0h-5.25M21 3v5.25" />
          </svg>
        </a>
      )}
    </div>
  )}

</article>
