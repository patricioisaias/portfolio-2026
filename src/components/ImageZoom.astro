---
// src/components/ImageZoom.astro
---

<!-- Lightbox Modal -->
<div
  id="image-zoom-modal"
  class="fixed inset-0 z-50 hidden items-center justify-center p-4 sm:p-8 bg-neutral-950/85 backdrop-blur-md opacity-0 transition-opacity duration-200 cursor-zoom-out"
  role="dialog"
  aria-modal="true"
  aria-label="Vista ampliada de imagen"
>
  <button
    id="image-zoom-close"
    type="button"
    class="absolute top-4 right-4 z-50 p-2.5 rounded-full bg-neutral-900/80 hover:bg-neutral-800 text-neutral-300 hover:text-white border border-neutral-700/60 backdrop-blur-sm transition-all focus:outline-none focus:ring-2 focus:ring-white/50"
    aria-label="Cerrar vista ampliada"
  >
    <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
      <path stroke-linecap="round" stroke-linejoin="round" d="M6 18 18 6M6 6l12 12" />
    </svg>
  </button>

  <div class="relative max-w-full max-h-full flex flex-col items-center justify-center pointer-events-auto">
    <img
      id="image-zoom-img"
      src=""
      alt=""
      class="max-w-[92vw] max-h-[85vh] object-contain shadow-2xl transition-transform duration-200 scale-95 select-none cursor-zoom-out"
    />
    <p
      id="image-zoom-caption"
      class="mt-3 text-xs sm:text-sm font-mono text-neutral-300 bg-neutral-900/80 px-3 py-1 border border-neutral-700/50 max-w-[90vw] text-center empty:hidden"
    ></p>
  </div>
</div>

<style is:global>
  /* Add zoom cursor to content images */
  .prose img,
  article img,
  figure img,
  [data-zoomable] img,
  .zoomable-img {
    cursor: zoom-in;
  }
</style>

<script>
  function setupImageZoom() {
    const modal = document.getElementById('image-zoom-modal');
    const zoomImg = document.getElementById('image-zoom-img') as HTMLImageElement | null;
    const zoomCaption = document.getElementById('image-zoom-caption');
    const closeBtn = document.getElementById('image-zoom-close');

    if (!modal || !zoomImg || !closeBtn) return;

    function openModal(src: string, alt: string) {
      if (!modal || !zoomImg) return;
      zoomImg.src = src;
      zoomImg.alt = alt || 'Imagen ampliada';
      if (zoomCaption) {
        zoomCaption.textContent = alt && alt !== 'Imagen ampliada' ? alt : '';
      }
      modal.classList.remove('hidden');
      modal.classList.add('flex');
      requestAnimationFrame(() => {
        modal.classList.remove('opacity-0');
        modal.classList.add('opacity-100');
        zoomImg.classList.remove('scale-95');
        zoomImg.classList.add('scale-100');
      });
      document.body.style.overflow = 'hidden';
    }

    function closeModal() {
      if (!modal || !zoomImg) return;
      modal.classList.remove('opacity-100');
      modal.classList.add('opacity-0');
      zoomImg.classList.remove('scale-100');
      zoomImg.classList.add('scale-95');
      setTimeout(() => {
        modal.classList.remove('flex');
        modal.classList.add('hidden');
        zoomImg.src = '';
        document.body.style.overflow = '';
      }, 200);
    }

    modal.onclick = (e) => {
      if (e.target === modal || (e.target as HTMLElement).closest('#image-zoom-close') || e.target === zoomImg) {
        closeModal();
      }
    };

    window.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && !modal.classList.contains('hidden')) {
        closeModal();
      }
    });

    const images = document.querySelectorAll<HTMLImageElement>(
      '.prose img, article .overflow-hidden img, figure img, [data-zoomable] img, .zoomable-img'
    );

    images.forEach((img) => {
      if (img.id === 'image-zoom-img') return;
      img.addEventListener('click', (e) => {
        // Allow zoom in detail pages and photography
        if (img.closest('figure') || img.closest('.prose') || img.closest('article') || img.hasAttribute('data-zoomable')) {
          e.preventDefault();
          e.stopPropagation();
          openModal(img.currentSrc || img.src, img.alt);
        }
      });
    });
  }

  setupImageZoom();
  document.addEventListener('astro:page-load', setupImageZoom);
  document.addEventListener('astro:after-swap', setupImageZoom);
</script>
