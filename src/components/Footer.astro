---
import { siteConfig } from '../site.config';

export interface Props {
  className?: string;
}

const { className = '' } = Astro.props;
const currentYear = new Date().getFullYear();
---

<footer class={`w-full border-t border-neutral-200/60 dark:border-neutral-800/60 py-10 transition-colors duration-200 ${className}`}>
  <div class="max-w-5xl mx-auto px-4 sm:px-6 flex flex-col sm:flex-row items-center justify-between gap-4 text-xs text-neutral-500 dark:text-neutral-400">
    
    <!-- Status & Identity -->
    <div class="flex items-center gap-2">
      <span class="relative flex h-2 w-2">
        <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span>
        <span class="relative inline-flex rounded-full h-2 w-2 bg-emerald-500"></span>
      </span>
      <span>{siteConfig.status}</span>
    </div>

    <!-- Links & Copyright -->
    <div class="flex items-center gap-6">
      <nav class="flex items-center gap-4 font-medium" aria-label="Enlaces de redes sociales">
        {siteConfig.socialLinks.map((link) => (
          <a
            href={link.href}
            target="_blank"
            rel="noopener noreferrer"
            class="hover:text-neutral-900 dark:hover:text-neutral-100 transition-colors underline-offset-4 hover:underline"
          >
            {link.name}
          </a>
        ))}
      </nav>
      <span class="text-neutral-400 dark:text-neutral-600 select-none">/</span>
      <span>© {currentYear} {siteConfig.author}</span>
    </div>

  </div>
</footer>
