---
import { siteConfig } from '../site.config';

export interface Props {
  className?: string;
}

const { className = '' } = Astro.props;
const currentYear = new Date().getFullYear();
---

<footer class={`w-full border-t border-neutral-200/60 dark:border-neutral-800/60 pt-10 pb-28 md:pb-10 transition-colors duration-200 ${className}`}>
  <div class="max-w-5xl mx-auto px-4 sm:px-6 flex flex-col sm:flex-row items-center justify-center gap-3 sm:gap-6 text-xs text-neutral-500 dark:text-neutral-400 text-center">
    <nav class="flex items-center gap-4 font-medium" aria-label="Enlaces de redes sociales">
      {siteConfig.socialLinks.map((link) => (
        <a
          href={link.href}
          target="_blank"
          rel="noopener noreferrer"
          class="hover:text-neutral-900 dark:hover:text-neutral-100 transition-colors underline-offset-4 hover:underline"
        >
          {link.name}
        </a>
      ))}
    </nav>
    <span class="hidden sm:inline text-neutral-300 dark:text-neutral-700 select-none">•</span>
    <span>© {currentYear} {siteConfig.author}</span>
  </div>
</footer>
